<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Executable consumers must match the native WinGet interop asset architecture. -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <TargetFramework>net8.0-windows10.0.26100</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <!-- REQUIRED for any executable consuming SubZeroDev.WinGet: the interop package's targets
         copy the native Microsoft.Management.Deployment.dll only into the output directory of
         projects that reference it DIRECTLY — it does not flow through a ProjectReference.
         Without this line the app fails at runtime with COMException 0x80040154. -->
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.280" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubZeroDev.WinGet\SubZeroDev.WinGet.csproj" />
  </ItemGroup>

</Project>
