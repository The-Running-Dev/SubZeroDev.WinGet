{"nodes": [{"id": "docs_troubleshooting_regdb_e_classnotreg", "label": "COMException 0x80040154 (REGDB_E_CLASSNOTREG)", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most common integration failure \u2014 the executable project is missing the direct ComInterop PackageReference, so the native activation DLL was never copied to its output directory."}, {"id": "docs_troubleshooting_wingetunavailableexception", "label": "Diagnosing WinGetUnavailableException", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranked causes: App Installer not installed, WinGet too old for the pinned 1.29.x interop contract, or COM activation blocked in the process context \u2014 the library already attempts the lower-trust activation fallback before giving up."}, {"id": "docs_troubleshooting_cswinrt_enumerator_bug", "label": "CsWinRT Projected Collection Enumerator Bug", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The projected collection enumerator is broken in interop 1.29.280 \u2014 only indexer access (.Count / [i]) works \u2014 so the library uses indexed for loops with fence comments to stop IDE 'simplify to foreach/LINQ' suggestions that would cause InvalidCastException: No such interface supported."}, {"id": "docs_troubleshooting_elevation_prohibited", "label": "Install Failure 0x8A150056 (installer prohibits elevation)", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_troubleshooting_requires_admin", "label": "Install Failure 0x8A150019 (command requires admin)", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_troubleshooting_accessdenied_sources", "label": "AccessDenied Adding/Removing Sources", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source add/remove modify machine-wide state and require an elevated caller; this is WinGet behavior, not a library restriction."}, {"id": "docs_troubleshooting_arp_entries", "label": "ARP\\ Prefixed Ids in Results", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not an error: the installed catalog includes software installed outside WinGet keyed by its raw Apps-and-Features registry entry; those entries cannot be targeted by id, so update UIs should filter on the ARP\\ prefix."}, {"id": "docs_troubleshooting_export_nonzero_exit", "label": "Export Non-zero Exit With Valid File", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "winget export exits non-zero when some installed applications are not available in any configured source, but still writes the file for everything it could map \u2014 treat 'file written' as the success signal when partial coverage is acceptable."}, {"id": "docs_troubleshooting_system_service_context", "label": "Running Under SYSTEM / Windows Service", "file_type": "concept", "source_file": "docs/troubleshooting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two considerations inherited from WinGet: no App Execution Alias exists in service contexts (the CLI shim already falls back to the WindowsApps package directory), and WinGet's install-scope preference in profile-less contexts can behave unexpectedly. This path is not covered by the test suite."}], "edges": [{"source": "docs_troubleshooting_regdb_e_classnotreg", "target": "docs_getting_started_direct_cominterop_packagereference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/troubleshooting.md", "source_location": null, "weight": 1.0}, {"source": "docs_troubleshooting_wingetunavailableexception", "target": "docs_getting_started_wingetunavailableexception", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/troubleshooting.md", "source_location": null, "weight": 1.0}, {"source": "docs_troubleshooting_cswinrt_enumerator_bug", "target": "docs_getting_started_iwingetclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/troubleshooting.md", "source_location": null, "weight": 1.0}, {"source": "docs_troubleshooting_elevation_prohibited", "target": "docs_usage_packages_getdetails", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/troubleshooting.md", "source_location": null, "weight": 1.0}, {"source": "docs_troubleshooting_requires_admin", "target": "docs_usage_packages_installrequest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/troubleshooting.md", "source_location": null, "weight": 1.0}, {"source": "docs_troubleshooting_elevation_prohibited", "target": "docs_troubleshooting_requires_admin", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/troubleshooting.md", "source_location": null, "weight": 1.0}, {"source": "docs_troubleshooting_accessdenied_sources", "target": "docs_usage_sources_elevation_requirement", "relation": "