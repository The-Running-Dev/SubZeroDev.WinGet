{"nodes": [{"id": "docs_intro_subzerodev_winget", "label": "SubZeroDev.WinGet (library overview)", "file_type": "document", "source_file": "docs/intro.md", "source_location": "docs/intro.md#subzerodevwinget", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps the WinGet COM API so callers avoid CsWinRT projections, COM activation quirks in elevated hosts, AND-only search filters, and WinRT structs; chosen over shelling out to winget.exe because column-aligned console tables are fragile against column widths, truncation ellipses, and non-Latin characters."}, {"id": "docs_intro_winget_com_api", "label": "WinGet COM API (Microsoft.Management.Deployment)", "file_type": "concept", "source_file": "docs/intro.md", "source_location": "docs/intro.md#subzerodevwinget", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same in-process API winget.exe itself is built on; gives structured, typed access to the same engine instead of parsed console output."}, {"id": "docs_intro_no_com_types_in_public_surface", "label": "No COM/WinRT types in the public surface", "file_type": "rationale", "source_file": "docs/intro.md", "source_location": "docs/intro.md#why-this-library", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callers only ever see plain C# records, enums, and interfaces, so COM/WinRT interop details never leak into consuming code."}, {"id": "docs_intro_no_async_suffix_convention", "label": "No Async method-name suffix convention", "file_type": "rationale", "source_file": "docs/intro.md", "source_location": "docs/intro.md#why-this-library", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every operation returns a Task, so the Async suffix would carry no information and is treated as noise."}, {"id": "docs_intro_cli_shim_exception", "label": "The one deliberate CLI exception", "file_type": "rationale", "source_file": "docs/intro.md", "source_location": "docs/intro.md#the-one-deliberate-exception", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin management and export/import have no COM equivalent at any WinGet contract version (verified against the winget-cli IDL), so only those two features shell out to winget.exe, isolated behind IWinGetCliClient; everything else stays pure COM."}], "edges": [{"source": "docs_intro_subzerodev_winget", "target": "docs_intro_winget_com_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/intro.md", "source_location": "docs/intro.md#subzerodevwinget", "weight": 1.0}, {"source": "docs_intro_subzerodev_winget", "target": "docs_intro_no_com_types_in_public_surface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/intro.md", "source_location": "docs/intro.md#why-this-library", "weight": 1.0}, {"source": "docs_intro_subzerodev_winget", "target": "docs_intro_no_async_suffix_convention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/intro.md", "source_location": "docs/intro.md#why-this-library", "weight": 1.0}, {"source": "docs_intro_subzerodev_winget", "target": "docs_intro_cli_shim_exception", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/intro.md", "source_location": "docs/intro.md#the-one-deliberate-exception", "weight": 1.0}, {"source": "docs_intro_subzerodev_winget", "target": "docs_getting_started_direct_interop_reference_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/intro.md", "source_location": "docs/intro.md#where-to-go-next", "weight": 1.0}, {"source": "docs_intro_subzerodev_winget", "target": "docs_usage_packages_search", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file