{"nodes": [{"id": "docs_getting_started_requirements", "label": "Runtime Requirements (Windows, .NET 8+, x64)", "file_type": "document", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets net8.0-windows10.0.26100 so net8/net9/net10 apps can all consume the package; ARM64 is declared but unvalidated on hardware."}, {"id": "docs_getting_started_direct_cominterop_packagereference", "label": "Direct ComInterop PackageReference Rule", "file_type": "rationale", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The interop package's build targets copy the native Microsoft.Management.Deployment.dll only into the output of projects that reference it directly; it does not flow transitively, so without a direct PackageReference the first COM call fails with COMException 0x80040154 (REGDB_E_CLASSNOTREG)."}, {"id": "docs_getting_started_platform_x64_pinning", "label": "x64 Platform Pinning", "file_type": "rationale", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The WinGet interop assembly is not AnyCPU, so consuming projects must override the default AnyCPU platform to x64."}, {"id": "docs_getting_started_github_packages_install", "label": "Installing from GitHub Packages", "file_type": "document", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub requires an authenticated source even for a public packages feed, so a read:packages PAT must be supplied as the source password."}, {"id": "docs_getting_started_addpackagemanagement", "label": "AddPackageManagement() DI Registration", "file_type": "concept", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registers the full interface surface as singletons in one call so consumers never wire COM factories by hand."}, {"id": "docs_getting_started_ipackagemanagementservice", "label": "IPackageManagementService", "file_type": "concept", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The recommended entry point: adds validation, structured logging, and a documented auto-retry policy on top of the raw COM client."}, {"id": "docs_getting_started_ipackagesourceservice", "label": "IPackageSourceService", "file_type": "concept", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_getting_started_iwingetclient", "label": "IWinGetClient", "file_type": "concept", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lower-level COM client kept public so callers who do not want retry/normalization can take a single unmodified attempt; its results are plain List<T> copies, insulating consumers from the broken CsWinRT enumerator."}, {"id": "docs_getting_started_iwingetsourceclient", "label": "IWinGetSourceClient", "file_type": "concept", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_getting_started_iwingetcliclient", "label": "IWinGetCliClient (winget.exe shim)", "file_type": "concept", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolated behind its own interface so the only CLI-shelling code in the library is confined to pins and export/import, which have no COM API."}, {"id": "docs_getting_started_wingetunavailableexception", "label": "WinGetUnavailableException", "file_type": "concept", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A typed, actionable exception is thrown when WinGet is missing, too old, or COM activation is blocked, so a raw COMException never escapes to the caller for that case."}, {"id": "docs_getting_started_error_handling_contract", "label": "Error Handling Contract (throw vs result record)", "file_type": "rationale", "source_file": "docs/getting-started.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Environment-level unavailability throws a typed exception, while ordinary operation failures return a result record with Succeeded, a normalized Status, the ExtendedErrorCode HRESULT, and the installer exit code \u2014 exceptions are reserved for conditions the caller cannot act on per-operation."}], "edges": [{"source": "docs_getting_started_addpackagemanagement", "target": "docs_getting_started_ipackagemanagementservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_addpackagemanagement", "target": "docs_getting_started_ipackagesourceservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_addpackagemanagement", "target": "docs_getting_started_iwingetclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_addpackagemanagement", "target": "docs_getting_started_iwingetsourceclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_addpackagemanagement", "target": "docs_getting_started_iwingetcliclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_ipackagemanagementservice", "target": "docs_getting_started_iwingetclient", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_error_handling_contract", "target": "docs_getting_started_wingetunavailableexception", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_error_handling_contract", "target": "docs_usage_packages_packageoperationresult", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_requirements", "target": "docs_getting_started_platform_x64_pinning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_direct_cominterop_packagereference", "target": "docs_troubleshooting_regdb_e_classnotreg", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}, {"source": "docs_getting_started_github_packages_install", "target": "docs_getting_started_direct_cominterop_packagereference", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/getting-started.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "di_registered_service_surface", "label": "Service surface registered by AddPackageManagement()", "nodes": ["docs_getting_started_addpackagemanagement", "docs_getting_started_ipackagemanagementservice", "docs_getting_started_ipackagesourceservice", "docs_getting_started_iwingetclient", "docs_getting_started_iwingetsourceclient", "docs_getting_started_iwingetcliclient"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started.md"}]}