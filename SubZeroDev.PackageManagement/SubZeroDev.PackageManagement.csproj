<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Microsoft.Management.Deployment.dll (WinGet COM interop) is not published AnyCPU,
         so the platform must be pinned explicitly rather than left to default resolution. -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net8.0-windows10.0.26100</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <PackageId>SubZeroDev.PackageManagement</PackageId>
    <Version>0.1.0</Version>
    <Authors>Ben Richards</Authors>
    <Description>A C# client library for the WinGet COM API (Microsoft.Management.Deployment): search, install, upgrade, uninstall, download, repair, source management, pins, and export/import — with no console output parsing and no COM/WinRT types in the public surface.</Description>
    <PackageTags>winget;package-management;windows;com;package-manager;app-installer</PackageTags>
    <PackageProjectUrl>https://github.com/The-Running-Dev/SubZeroDev.PackageManagement</PackageProjectUrl>
    <RepositoryUrl>https://github.com/The-Running-Dev/SubZeroDev.PackageManagement</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member carries XML docs yet; don't fail or spam the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SubZeroDev.PackageManagement.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.280" />
  </ItemGroup>

</Project>
